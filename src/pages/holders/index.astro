---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Portal Holders | Andes Solar Hash"
  description="Portal de activación para holders de NFTs productivos de Andes Solar Hash."
  noindex={true}
>
  <div class="holders-page">

    <!-- HERO -->
    <section class="holders-hero">
      <div class="holders-hero-inner">
        <div class="ash-badge">
          <span class="ash-badge-dot"></span>
          <span>PORTAL EXCLUSIVO · HOLDERS</span>
        </div>
        <h1>Activa tu <span class="gold-text">NFT Productivo</span></h1>
        <p class="hero-sub">Conecta tu wallet para verificar tu NFT y completar el registro como holder oficial de Andes Solar Hash.</p>
      </div>
    </section>

    <!-- MAIN CARD -->
    <section class="holders-main">
      <div class="holders-card">

        <!-- STEP INDICATOR -->
        <div class="steps" id="steps">
          <div class="step active" id="step-dot-1"><span>1</span><span class="step-label">Wallet</span></div>
          <div class="step-line"></div>
          <div class="step" id="step-dot-2"><span>2</span><span class="step-label">Verificar</span></div>
          <div class="step-line"></div>
          <div class="step" id="step-dot-3"><span>3</span><span class="step-label">Registro</span></div>
        </div>

        <!-- PANEL 1: CONNECT WALLET -->
        <div id="panel-connect" class="panel active">
          <div class="panel-icon">🔗</div>
          <h2 class="panel-title">Verifica tu NFT</h2>
          <p class="panel-sub">Conecta tu wallet para verificar que posees un NFT de Andes Solar Hash.</p>

          <button id="btn-connect" class="btn-primary btn-large">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="2"/></svg>
            Conectar Wallet
          </button>

          <p class="note" id="connect-note">Compatible con MetaMask, WalletConnect, Coinbase Wallet, Rabby y 300+ wallets.</p>
        </div>

        <!-- PANEL 2: VERIFYING -->
        <div id="panel-verify" class="panel">
          <div class="panel-icon spin-icon">⟳</div>
          <h2 class="panel-title">Verificando NFT</h2>
          <p class="panel-sub" id="verify-status">Comprobando propiedad en la blockchain Polygon…</p>
          <div class="wallet-chip" id="verify-wallet"></div>
        </div>

        <!-- PANEL 3: NO NFT -->
        <div id="panel-no-nft" class="panel">
          <div class="panel-icon">🔒</div>
          <h2 class="panel-title" style="color:#ff6b6b;">Acceso no autorizado</h2>
          <p class="panel-sub">La wallet conectada no tiene ningún NFT de la colección <strong>Minero S21+ Andes SolarHash</strong>.</p>
          <div class="wallet-chip" id="no-nft-wallet"></div>
          <a href="/nft/" class="btn-primary" style="margin-top:20px;">Ver colección NFT →</a>
          <button id="btn-reconnect" class="btn-ghost" style="margin-top:12px;">Conectar otra wallet</button>
        </div>

        <!-- PANEL 4: FORM -->
        <div id="panel-form" class="panel">
          <div class="form-header">
            <div class="nft-verified-badge">
              <span>✓</span> NFT verificado
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
              <div class="wallet-chip" id="form-wallet"></div>
              <button id="btn-disconnect" type="button" class="btn-disconnect">Desconectar</button>
            </div>
          </div>
          <h2 class="panel-title">Completa tu registro</h2>
          <p class="panel-sub">Esta información es necesaria para gestionar los pagos de márgenes operativos y el cumplimiento tributario.</p>

          <form id="holders-form" novalidate>
            <input type="hidden" id="f-wallet" name="wallet" />
            <input type="hidden" id="f-nft-count" name="nft_count" />

            <div class="form-row">
              <div class="form-group">
                <label for="f-nombre">Nombre completo <span class="req">*</span></label>
                <input type="text" id="f-nombre" name="nombre" placeholder="Ej: Juan Pérez González" required autocomplete="name" />
              </div>
              <div class="form-group">
                <label for="f-email">Correo electrónico <span class="req">*</span></label>
                <input type="email" id="f-email" name="email" placeholder="correo@ejemplo.com" required autocomplete="email" />
              </div>
            </div>

            <div class="form-group">
              <label for="f-pais">País de residencia <span class="req">*</span></label>
              <select id="f-pais" name="pais" required>
                <option value="">— Seleccione su país —</option>
                <option value="Chile" selected>Chile</option>
                <option value="Argentina">Argentina</option>
                <option value="Colombia">Colombia</option>
                <option value="México">México</option>
                <option value="Perú">Perú</option>
                <option value="Uruguay">Uruguay</option>
                <option value="Brasil">Brasil</option>
                <option value="España">España</option>
                <option value="Estados Unidos">Estados Unidos</option>
                <option value="Alemania">Alemania</option>
                <option value="Reino Unido">Reino Unido</option>
                <option value="Francia">Francia</option>
                <option value="Italia">Italia</option>
                <option value="Otro">Otro</option>
              </select>
            </div>

            <!-- Tipo comprador (solo visible para extranjeros) -->
            <div class="form-group hidden" id="group-tipo">
              <label>Tipo de comprador <span class="req">*</span></label>
              <div class="radio-group">
                <label class="radio-option">
                  <input type="radio" name="tipo_comprador" id="tipo-persona" value="Extranjero Persona" checked />
                  <span>Persona natural</span>
                </label>
                <label class="radio-option">
                  <input type="radio" name="tipo_comprador" id="tipo-empresa" value="Extranjero Empresa" />
                  <span>Empresa</span>
                </label>
              </div>
            </div>

            <!-- Nombre empresa (solo visible si es empresa extranjera) -->
            <div class="form-group hidden" id="group-empresa">
              <label for="f-empresa">Nombre de la empresa <span class="req">*</span></label>
              <input type="text" id="f-empresa" name="nombre_empresa" placeholder="Razón social de la empresa" autocomplete="organization" />
            </div>

            <!-- Chile: RUT -->
            <div class="form-group" id="group-rut">
              <label for="f-rut">RUT <span class="req">*</span></label>
              <input type="text" id="f-rut" name="rut" placeholder="Ej: 12.345.678-9" autocomplete="off" />
              <span class="field-hint">Formato: 12.345.678-9 o sin puntos</span>
            </div>

            <!-- Extranjero: Tax ID -->
            <div class="form-group hidden" id="group-taxid">
              <label for="f-taxid">Tax ID / Número tributario</label>
              <input type="text" id="f-taxid" name="tax_id" placeholder="NIF, CUIT, CPF, SSN, etc." autocomplete="off" />
              <span class="field-hint">Opcional según país de residencia</span>
            </div>

            <div class="form-group">
              <label for="f-direccion">Dirección de residencia <span class="req">*</span></label>
              <input type="text" id="f-direccion" name="direccion" placeholder="Calle, número, ciudad, país" required autocomplete="street-address" />
            </div>

            <div class="form-group">
              <label for="f-telefono">Teléfono (opcional)</label>
              <input type="tel" id="f-telefono" name="telefono" placeholder="+56 9 1234 5678" autocomplete="tel" />
            </div>

            <div class="form-check">
              <input type="checkbox" id="f-terms" required />
              <label for="f-terms">Acepto los <a href="/legal/terminos-nft/" target="_blank">Términos y Condiciones NFT</a> y la <a href="/legal/privacidad/" target="_blank">Política de Privacidad</a></label>
            </div>

            <button type="submit" id="btn-submit" class="btn-primary btn-large btn-full">
              Activar registro de holder
            </button>

            <div id="form-error" class="form-error hidden"></div>
          </form>
        </div>

        <!-- PANEL 5: SUCCESS -->
        <div id="panel-success" class="panel">
          <div class="success-icon">✓</div>
          <h2 class="panel-title">¡Registro completado!</h2>
          <p class="panel-sub">Tu información ha sido recibida. El equipo de Andes Solar Hash procesará tu activación y te contactará a la brevedad.</p>
          <div class="success-box">
            <p class="success-box-title">Próximo paso</p>
            <p>Únete al canal privado de holders en Discord para recibir los reportes semanales de operación y los pagos de márgenes.</p>
            <a href="https://discord.gg/2W9aTR52" target="_blank" rel="noopener noreferrer" class="btn-primary" style="margin-top:16px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.3 4.3A18 18 0 0 0 15.6 3c-.2.4-.5.9-.7 1.3a16.6 16.6 0 0 0-5 0c-.2-.4-.4-.9-.7-1.3A18 18 0 0 0 4 4.3a17.5 17.5 0 0 0-2.8 10c2.4 1.8 4.8 2.8 7 3.5.6-.8 1-1.6 1.5-2.5l-.1-.1a11.6 11.6 0 0 1-1.7-.8l.2-.5a12.4 12.4 0 0 0 10.4 0l.2.5a11.6 11.6 0 0 1-1.7.8v.1c.4.9.9 1.7 1.5 2.5 2.3-.7 4.7-1.7 7-3.5A17.4 17.4 0 0 0 20.3 4.3zM8.7 13.3c-1 0-1.8-.9-1.8-2s.8-2 1.8-2c1 0 1.9.9 1.8 2 0 1.1-.8 2-1.8 2zm6.6 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2c1 0 1.9.9 1.8 2 0 1.1-.8 2-1.8 2z"/></svg>
              Unirse al Discord de Holders
            </a>
          </div>
        </div>

      </div><!-- /.holders-card -->

      <!-- INFO SIDEBAR -->
      <div class="holders-info">
        <div class="info-card">
          <h3>¿Qué es esto?</h3>
          <p>Este portal permite a los holders de NFTs productivos de Andes Solar Hash completar su proceso de activación KYC para recibir los pagos de márgenes operativos semanales.</p>
        </div>
        <div class="info-card">
          <h3>¿Por qué necesito registrarme?</h3>
          <ul>
            <li>Cumplimiento tributario (SII)</li>
            <li>Verificación de identidad del receptor</li>
            <li>Coordinación de pagos en CLP o cripto</li>
            <li>Acceso al Discord privado de holders</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>Seguridad</h3>
          <p>Tus datos se transmiten de forma cifrada y son usados únicamente para la gestión operativa de Andes Solar Hash SpA. No compartimos información con terceros.</p>
        </div>
        <div class="info-card info-card-contract">
          <p class="contract-label">Contrato NFT V2 · Polygon</p>
          <p class="contract-addr">0x40D9a1...7864</p>
          <a href="https://polygonscan.com/address/0x40D9a1FDec62795723f065b05f792A6159727864" target="_blank" rel="noopener noreferrer" class="contract-link">Ver en PolygonScan →</a>
        </div>
      </div>

    </section>
  </div>
</Layout>

<script is:inline type="module">
(function () {
  var CONTRACT     = '0x40D9a1FDec62795723f065b05f792A6159727864'; // V2 ERC1155
  var COLLECTION_ID = 1; // Colección S21+ ($60 USDC)
  var WEBHOOK      = 'https://hook.us2.make.com/2k9vtp93xg5el54q1tkndmeyhpveapnf';

  // ── Botón en estado cargando mientras AppKit inicializa ─────────────────
  var btnConnect = document.getElementById('btn-connect');
  btnConnect.disabled = true;
  btnConnect.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg> Cargando…';

  // ── Carga dinámica de AppKit (evita que el botón se clickee antes de que cargue) ─
  Promise.all([
    import('https://esm.sh/@reown/appkit@1.7.7?bundle'),
    import('https://esm.sh/@reown/appkit-adapter-ethers@1.7.7?bundle')
  ]).then(function (mods) {
    var createAppKit  = mods[0].createAppKit;
    var EthersAdapter = mods[1].EthersAdapter;

    var polygon = {
      id: 137,
      caipNetworkId: 'eip155:137',
      chainNamespace: 'eip155',
      name: 'Polygon',
      nativeCurrency: { name: 'MATIC', symbol: 'MATIC', decimals: 18 },
      rpcUrls: { default: { http: ['https://polygon-rpc.com'] } },
      blockExplorers: { default: { name: 'PolygonScan', url: 'https://polygonscan.com' } }
    };

    var ethersAdapter = new EthersAdapter();
    var modal = createAppKit({
      adapters: [ethersAdapter],
      networks: [polygon],
      defaultNetwork: polygon,
      projectId: '5ad962d1ec9b99a4e42bd27b2cbabb96',
      metadata: {
        name: 'Andes Solar Hash',
        description: 'Portal de Holders NFT Productivos',
        url: 'https://andessolarhash.com',
        icons: ['https://andessolarhash.com/favicon.svg']
      },
      features: { analytics: false, email: false, socials: [] }
    });

    // Guardar referencia global al modal
    _appkitModal = modal;

    // Botón listo
    btnConnect.disabled = false;
    btnConnect.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="2"/></svg> Conectar Wallet';

    // AppKit: escucha conexión
    modal.subscribeAccount(function (state) {
      if (state.isConnected && state.address && !connectedWallet) {
        connectedWallet = state.address;
        try { modal.close(); } catch(_) {}
        showPanel('panel-verify');
        setStep(2);
        setWalletChip('verify-wallet', connectedWallet);
        verifyNFT(connectedWallet);
      }
      if (!state.isConnected) { connectedWallet = null; }
    });

    btnConnect.addEventListener('click', function () {
      modal.open({ view: 'Connect' });
    });

  }).catch(function (err) {
    // Si AppKit falla, al menos el botón manual sigue funcionando
    btnConnect.disabled = false;
    btnConnect.innerHTML = 'Conectar Wallet';
    console.warn('AppKit no cargó:', err);
  });

  // ── Estado ─────────────────────────────────────────────────────────────

  var ABI_BALANCE = [
    'function balanceOf(address owner) view returns (uint256)'
  ];

  // State
  var connectedWallet = null;
  var nftCount = 0;
  var tokenId = '';
  var _appkitModal = null; // referencia al modal AppKit para desconectar

  // Panels
  function showPanel(id) {
    document.querySelectorAll('.panel').forEach(function (p) { p.classList.remove('active'); });
    var el = document.getElementById(id);
    if (el) el.classList.add('active');
  }

  function setStep(n) {
    for (var i = 1; i <= 3; i++) {
      var dot = document.getElementById('step-dot-' + i);
      if (!dot) continue;
      dot.classList.remove('active', 'done');
      if (i < n) dot.classList.add('done');
      else if (i === n) dot.classList.add('active');
    }
  }

  function shortAddr(addr) {
    return addr.slice(0, 6) + '…' + addr.slice(-4);
  }

  function setWalletChip(id, addr) {
    var el = document.getElementById(id);
    if (el) el.textContent = shortAddr(addr);
  }

  // Botón desconectar — desconecta AppKit y MetaMask directo, vuelve a panel-connect
  document.getElementById('btn-disconnect').addEventListener('click', function () {
    connectedWallet = null;
    nftCount = 0;
    tokenId = '';
    // Desconectar AppKit si estaba activo
    if (_appkitModal) {
      _appkitModal.disconnect().catch(function(){});
    }
    showPanel('panel-connect');
    setStep(1);
  });

  var reconnectBtn = document.getElementById('btn-reconnect');
  if (reconnectBtn) reconnectBtn.addEventListener('click', function () {
    connectedWallet = null;
    showPanel('panel-connect');
    setStep(1);
  });

  function showConnectError(msg) {
    var note = document.getElementById('connect-note');
    if (note) note.innerHTML = '<span style="color:#ff8a8a;">' + msg + '</span>';
  }

  // Direct RPC call to Polygon — no MetaMask needed
  async function rpcCall(callData) {
    var rpcs = [
      'https://polygon-rpc.com',
      'https://rpc-mainnet.matic.quiknode.pro',
      'https://polygon.llamarpc.com'
    ];
    for (var i = 0; i < rpcs.length; i++) {
      try {
        var res = await fetch(rpcs[i], {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jsonrpc: '2.0', method: 'eth_call',
            params: [{ to: CONTRACT, data: callData }, 'latest'],
            id: 1
          })
        });
        var json = await res.json();
        if (json.result) return json.result;
      } catch (_) { /* try next RPC */ }
    }
    throw new Error('No se pudo conectar a la blockchain. Intenta de nuevo.');
  }

  async function verifyNFT(address) {
    var statusEl = document.getElementById('verify-status');
    statusEl.textContent = 'Consultando contrato en Polygon…';

    try {
      var paddedAddr = address.toLowerCase().replace('0x', '').padStart(64, '0');
      var paddedId   = COLLECTION_ID.toString(16).padStart(64, '0');

      // ERC1155 balanceOf(address,uint256) — selector 0x00fdd58e
      var balResult = await rpcCall('0x00fdd58e' + paddedAddr + paddedId);
      nftCount = balResult && balResult !== '0x' ? parseInt(balResult, 16) : 0;
      tokenId = nftCount > 0 ? String(COLLECTION_ID) : '';

      if (nftCount > 0) {

        statusEl.textContent = '¡NFT verificado! Tienes ' + nftCount + ' NFT' + (nftCount > 1 ? 's' : '') + (tokenId ? ' (Token #' + tokenId + ')' : '') + '.';
        setTimeout(function () {
          document.getElementById('f-wallet').value = address;
          document.getElementById('f-nft-count').value = nftCount;
          setWalletChip('form-wallet', address);
          showPanel('panel-form');
          setStep(3);
        }, 900);
      } else {
        setWalletChip('no-nft-wallet', address);
        showPanel('panel-no-nft');
      }
    } catch (err) {
      statusEl.textContent = '⚠️ ' + (err.message || 'Error al verificar. Intenta de nuevo.');
      setTimeout(function () {
        showPanel('panel-connect');
        setStep(1);
        resetConnectBtn();
      }, 4000);
    }
  }

  // Country/tipo toggle
  function updateFormFields() {
    var pais = document.getElementById('f-pais').value;
    var isChile = pais === 'Chile';
    var tipoEmpresa = document.querySelector('input[name="tipo_comprador"]:checked');
    var isEmpresa = tipoEmpresa && tipoEmpresa.value === 'Extranjero Empresa';

    document.getElementById('group-rut').classList.toggle('hidden', !isChile);
    document.getElementById('group-taxid').classList.toggle('hidden', isChile);
    document.getElementById('group-tipo').classList.toggle('hidden', isChile);
    document.getElementById('group-empresa').classList.toggle('hidden', isChile || !isEmpresa);

    document.getElementById('f-rut').required = isChile;
    document.getElementById('f-taxid').required = false; // optional per brief
    document.getElementById('f-empresa') && (document.getElementById('f-empresa').required = !isChile && isEmpresa);
  }

  document.getElementById('f-pais').addEventListener('change', updateFormFields);
  document.querySelectorAll('input[name="tipo_comprador"]').forEach(function (r) {
    r.addEventListener('change', updateFormFields);
  });
  updateFormFields(); // initial state

  // Form submit
  document.getElementById('holders-form').addEventListener('submit', async function (e) {
    e.preventDefault();
    var btn = document.getElementById('btn-submit');
    var errEl = document.getElementById('form-error');
    errEl.classList.add('hidden');

    // Validate
    if (!this.checkValidity()) {
      this.reportValidity();
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Enviando…';

    var pais = document.getElementById('f-pais').value;
    var isChile = pais === 'Chile';
    var tipoChecked = document.querySelector('input[name="tipo_comprador"]:checked');
    var tipoComprador = isChile ? 'Chileno' : (tipoChecked ? tipoChecked.value : 'Extranjero Persona');
    var rutTaxId = isChile
      ? document.getElementById('f-rut').value.trim()
      : document.getElementById('f-taxid').value.trim();
    var nombreEmpresa = (!isChile && tipoComprador === 'Extranjero Empresa')
      ? (document.getElementById('f-empresa') ? document.getElementById('f-empresa').value.trim() : '')
      : '';

    var payload = {
      wallet: document.getElementById('f-wallet').value,
      tokenId: tokenId,
      nombre: document.getElementById('f-nombre').value.trim(),
      email: document.getElementById('f-email').value.trim(),
      pais: pais,
      rutTaxId: rutTaxId,
      direccion: document.getElementById('f-direccion').value.trim(),
      tipoComprador: tipoComprador,
      nombreEmpresa: nombreEmpresa,
      telefono: document.getElementById('f-telefono').value.trim(),
      source: 'portal-holders'
    };

    try {
      var res = await fetch(WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (res.ok || res.status === 200) {
        showPanel('panel-success');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        throw new Error('HTTP ' + res.status);
      }
    } catch (err) {
      errEl.textContent = 'Error al enviar el formulario. Intenta nuevamente o escríbenos a soporte@andessolarhash.com';
      errEl.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Activar registro de holder';
    }
  });
})();
</script>

<style>
  .holders-page {
    background: #0b0d1b;
    min-height: 100vh;
  }

  /* HERO */
  .holders-hero {
    background: linear-gradient(to bottom, #111428, #0b0d1b);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 120px 32px 56px;
    text-align: center;
  }
  .holders-hero-inner {
    max-width: 680px;
    margin: 0 auto;
  }
  .ash-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(247,173,31,0.35);
    border-radius: 9999px;
    padding: 6px 16px;
    font-family: 'Maven Pro', sans-serif;
    font-size: 11px;
    font-weight: 700;
    color: #f7ad1f;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .ash-badge-dot {
    width: 6px;
    height: 6px;
    background: #f7ad1f;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .holders-hero h1 {
    font-family: 'Maven Pro', sans-serif;
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 900;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 16px;
