<script is:inline type="module">
(function () {
  var CONTRACT_V2  = '0x40D9a1FDec62795723f065b05f792A6159727864';
  var USDC_ADDRESS = '0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359';
  var COLLECTION_ID = 1;
  var PRICE_USDC   = 60_000_000n;
  var WEBHOOK      = 'https://hook.us2.make.com/2k9vtp93xg5el54q1tkndmeyhpveapnf';
  var POLYGON_RPC  = 'https://polygon-bor-rpc.publicnode.com';

  var ASH_ABI = [
    'function mintWithUSDC(uint256 collectionId, uint256 amount)',
    'function mintWithPOL(uint256 collectionId, uint256 amount) payable',
    'function getPolAmount(uint256 usdcAmount) view returns (uint256)',
  ];
  var ERC20_ABI = [
    'function approve(address spender, uint256 amount) returns (bool)',
    'function allowance(address owner, address spender) view returns (uint256)',
    'function balanceOf(address) view returns (uint256)',
  ];

  var connectedWallet = null;
  var kycData = {};
  var selectedMethod = null; // 'usdc' | 'pol' | 'clp'
  var _modal = null;
  var _ethers = null;

  // ── Modal open/close ────────────────────────────────────────────────────
  var modal = document.getElementById('purchase-modal');
  function openModal() {
    showPanel('pp-choose'); setStep(1);
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    fetchPolPrice();
  }
  function closeModal() { modal.style.display = 'none'; document.body.style.overflow = ''; }
  document.getElementById('btn-open-purchase').addEventListener('click', openModal);
  document.getElementById('pmodal-close').addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });

  // ── UI ──────────────────────────────────────────────────────────────────
  function showPanel(id) {
    document.querySelectorAll('.ppanel').forEach(function(p) { p.classList.remove('active'); });
    var el = document.getElementById(id);
    if (el) el.classList.add('active');
  }
  function setStep(n) {
    for (var i = 1; i <= 4; i++) {
      var d = document.getElementById('pstep-' + i);
      if (!d) continue;
      d.classList.remove('active','done');
      if (i < n) d.classList.add('done');
      else if (i === n) d.classList.add('active');
    }
  }
  function chip(id, addr) {
    var el = document.getElementById(id);
    if (el) el.textContent = addr ? addr.slice(0,6)+'…'+addr.slice(-4) : '';
  }
  function txStep(msg, done) {
    var el = document.getElementById('ptx-steps');
    if (!el) return;
    var d = document.createElement('div');
    d.className = 'ptx-step ' + (done ? 'done' : 'pending');
    d.textContent = (done ? '✓ ' : '⟳ ') + msg;
    el.appendChild(d);
  }

  // ── POL price (CoinGecko for display, contract for actual amount) ────────
  async function fetchPolPrice() {
    var el = document.getElementById('pol-choose-desc');
    // Try POL (new token ID), then MATIC fallback
    var apis = [
      ['https://api.coingecko.com/api/v3/simple/price?ids=polygon-ecosystem-token&vs_currencies=usd', 'polygon-ecosystem-token'],
      ['https://api.coingecko.com/api/v3/simple/price?ids=matic-network&vs_currencies=usd', 'matic-network'],
    ];
    for (var i = 0; i < apis.length; i++) {
      try {
        var r = await fetch(apis[i][0], { signal: AbortSignal.timeout(6000) });
        if (!r.ok) continue;
        var data = await r.json();
        var polUSD = data[apis[i][1]]?.usd;
        if (polUSD && el) {
          var polAmt = (60 / polUSD).toFixed(2);
          el.textContent = '≈ ' + polAmt + ' POL · $60 USD';
          return;
        }
      } catch(_) {}
    }
    // Fallback: precio aproximado POL desde contrato
    try {
      var res = await fetch(POLYGON_RPC, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({jsonrpc:'2.0',method:'eth_call',
          params:[{to:CONTRACT_V2, data:'0x8c7408c4'+'0000000000000000000000000000000000000000000000000000000003938700'},'latest'],id:9})
      });
      var json = await res.json();
      if (json.result && json.result !== '0x') {
        var pol = Number(BigInt(json.result)) / 1e18;
        if (el) el.textContent = '≈ ' + pol.toFixed(2) + ' POL · $60 USD';
        return;
      }
    } catch(_) {}
    if (el) el.textContent = '≈ precio POL · $60 USD';
  }
  async function loadPolPrice() {
    try {
      var paddedAmt = '0000000000000000000000000000000000000000000000000000000003938700';
      var res = await fetch(POLYGON_RPC, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({jsonrpc:'2.0',method:'eth_call',
          params:[{to:CONTRACT_V2, data:'0x8c7408c4'+paddedAmt},'latest'],id:2})
      });
      var json = await res.json();
      if (json.result && json.result !== '0x') {
        var pol = Number(BigInt(json.result)) / 1e18;
        document.getElementById('ppol-desc').textContent = pol.toFixed(2) + ' POL · ≈$60 USD';
      }
    } catch(_) { document.getElementById('ppol-desc').textContent = '≈ equivalente a $60 USD'; }
  }

  // ── Choose method ─────────────────────────────────────────────────────────
  document.getElementById('pchoose-usdc').addEventListener('click', function() {
    selectedMethod = 'usdc';
    showPanel('pp-connect'); setStep(2);
  });
  document.getElementById('pchoose-pol').addEventListener('click', function() {
    selectedMethod = 'pol';
    showPanel('pp-connect'); setStep(2);
  });
  document.getElementById('pchoose-clp').addEventListener('click', function() {
    selectedMethod = 'clp';
    // Hide wallet row, show CLP wallet field
    document.getElementById('pkyc-wallet-row').style.display = 'none';
    document.getElementById('pgroup-wallet-clp').classList.remove('phidden');
    document.getElementById('pkyc-submit-btn').textContent = 'Proceder al pago en CLP →';
    showPanel('pp-kyc'); setStep(3);
  });

  // ── AppKit ───────────────────────────────────────────────────────────────
  var pbtnConnect = document.getElementById('pbtn-connect');
  pbtnConnect.disabled = true;
  pbtnConnect.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:pspin 1s linear infinite"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg> Cargando…';

  Promise.all([
    import('https://esm.sh/@reown/appkit@1.7.7?bundle'),
    import('https://esm.sh/@reown/appkit-adapter-ethers@1.7.7?bundle'),
    import('https://esm.sh/ethers@6.13.0?bundle'),
  ]).then(function(mods) {
    var createAppKit  = mods[0].createAppKit;
    var EthersAdapter = mods[1].EthersAdapter;
    _ethers = mods[2];

    var polygon = {
      id:137, caipNetworkId:'eip155:137', chainNamespace:'eip155', name:'Polygon',
      nativeCurrency:{name:'POL',symbol:'POL',decimals:18},
      rpcUrls:{default:{http:[POLYGON_RPC]}},
      blockExplorers:{default:{name:'PolygonScan',url:'https://polygonscan.com'}}
    };
    var appkit = createAppKit({
      adapters:[new EthersAdapter()], networks:[polygon], defaultNetwork:polygon,
      projectId:'5ad962d1ec9b99a4e42bd27b2cbabb96',
      metadata:{name:'Andes Solar Hash',description:'Compra tu NFT Minero S21+',url:'https://andessolarhash.com',icons:['https://andessolarhash.com/favicon.svg']},
      features:{analytics:false,email:false,socials:[]}
    });
    _modal = appkit;
    pbtnConnect.disabled = false;
    pbtnConnect.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="2"/></svg> Conectar Wallet';

    // ── Wallet connection handler ──────────────────────────────────────────
    var _pollTimer = null;
    var _pmodalBox = document.querySelector('.pmodal-box');
    function showPurchaseBox() { if (_pmodalBox) _pmodalBox.classList.remove('wallet-open'); }
    function hidePurchaseBox() { if (_pmodalBox) _pmodalBox.classList.add('wallet-open'); }
    function handleWalletConnected(addr) {
      if (connectedWallet || !addr) return;
      if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }
      connectedWallet = addr;
      showPurchaseBox();
      try { appkit.close(); } catch(_) {}
      document.getElementById('pkyc-wallet-row').style.display = '';
      document.getElementById('pgroup-wallet-clp').classList.add('phidden');
      document.getElementById('pkyc-submit-btn').textContent = 'Continuar al pago →';
      chip('pkyc-wallet', connectedWallet);
      chip('ppay-wallet', connectedWallet);
      showPanel('pp-kyc'); setStep(3);
    }

    // subscribeAccount (fires in most browsers)
    try {
      appkit.subscribeAccount(function(state) {
        var addr = state.address || (state.caipAddress ? state.caipAddress.split(':').pop() : null);
        var connected = state.isConnected || state.status === 'connected';
        if (connected && addr) handleWalletConnected(addr);
        if (!connected && !state.address) connectedWallet = null;
      });
    } catch(_) {}

    // subscribeEvents fallback
    try {
      appkit.subscribeEvents(function(ev) {
        var name = ev?.data?.event || ev?.event || '';
        if (name === 'CONNECT_SUCCESS') {
          try {
            var acc = appkit.getAccount ? appkit.getAccount() : null;
            if (acc && acc.address) handleWalletConnected(acc.address);
          } catch(_) {}
        }
        if (name === 'MODAL_CLOSE') {
          // User closed modal without connecting — restore purchase box
          if (!connectedWallet) showPurchaseBox();
        }
      });
    } catch(_) {}

    pbtnConnect.addEventListener('click', function() {
      hidePurchaseBox();
      appkit.open({view:'Connect'});
      // Polling: check every 600ms for up to 3 minutes
      if (_pollTimer) clearInterval(_pollTimer);
      _pollTimer = setInterval(function() {
        try {
          var acc = appkit.getAccount ? appkit.getAccount() : null;
          var addr = acc && (acc.address || (acc.caipAddress ? acc.caipAddress.split(':').pop() : null));
          if (addr) { handleWalletConnected(addr); return; }
          // If AppKit modal closed without connecting, restore box
          var wm = document.querySelector('w3m-modal, wcm-modal, appkit-modal');
          if (wm) {
            var open = wm.getAttribute('open') || wm.shadowRoot?.querySelector('[data-open]');
            if (open === null || open === 'false') { showPurchaseBox(); clearInterval(_pollTimer); _pollTimer = null; }
          }
        } catch(_) {}
      }, 600);
      setTimeout(function() { if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; showPurchaseBox(); } }, 180000);
    });
  }).catch(function() {
    pbtnConnect.disabled = false;
    pbtnConnect.innerHTML = 'Conectar Wallet';
  });

  // ── Disconnect / back ────────────────────────────────────────────────────
  document.getElementById('pbtn-disconnect').addEventListener('click', function() {
    connectedWallet = null;
    if (_modal) _modal.disconnect().catch(function(){});
    showPanel('pp-connect'); setStep(2);
  });
  document.getElementById('pbtn-back').addEventListener('click', function() {
    showPanel('pp-kyc'); setStep(3);
  });
  document.getElementById('pbtn-back-choose').addEventListener('click', function() {
    showPanel('pp-choose'); setStep(1);
  });

  // ── País toggle ──────────────────────────────────────────────────────────
  function updateFields() {
    var chile = document.getElementById('pf-pais').value === 'Chile';
    document.getElementById('pgroup-rut').classList.toggle('phidden', !chile);
    document.getElementById('pgroup-taxid').classList.toggle('phidden', chile);
    document.getElementById('pf-rut').required = chile;
  }
  document.getElementById('pf-pais').addEventListener('change', updateFields);
  updateFields();

  // ── KYC submit ───────────────────────────────────────────────────────────
  document.getElementById('pkyc-form').addEventListener('submit', function(e) {
    e.preventDefault();
    if (!this.checkValidity()) { this.reportValidity(); return; }
    var chile = document.getElementById('pf-pais').value === 'Chile';
    kycData = {
      wallet: selectedMethod === 'clp' ? (document.getElementById('pf-wallet-clp').value.trim() || 'sin-wallet') : connectedWallet,
      nombre: document.getElementById('pf-nombre').value.trim(),
      email:  document.getElementById('pf-email').value.trim(),
      pais:   document.getElementById('pf-pais').value,
      rutTaxId: chile ? document.getElementById('pf-rut').value.trim() : document.getElementById('pf-taxid').value.trim(),
      direccion: document.getElementById('pf-direccion').value.trim(),
      source: 'compra-nft-modal'
    };

    if (selectedMethod === 'clp') {
      fetch(WEBHOOK, { method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({...kycData, metodoPago:'CLP-Flow', estado:'Pendiente pago'})
      }).catch(function(){});
      chip('pclp-wallet', kycData.wallet !== 'sin-wallet' ? kycData.wallet : '');
      showPanel('pp-clp');
      setTimeout(function() {
        window.location.href = 'https://www.flow.cl/btn.php?token=w29c50be5a01ae9ff8a5aee1bf58378a9f2d40f2';
      }, 1800);
      return;
    }

    // Crypto flow
    chip('ppay-wallet', connectedWallet);
    // Show correct payment box
    document.getElementById('ppay-usdc-box').style.display = selectedMethod === 'usdc' ? '' : 'none';
    document.getElementById('ppay-pol-box').style.display = selectedMethod === 'pol' ? '' : 'none';
    if (selectedMethod === 'pol') loadPolPrice();
    document.getElementById('ppay-error').classList.add('phidden');
    showPanel('pp-payment'); setStep(4);
  });

  // ── Pago USDC ────────────────────────────────────────────────────────────
  document.getElementById('pbtn-usdc').addEventListener('click', async function() {
    if (!connectedWallet || !_ethers || !_modal) return;
    showPanel('pp-processing');
    document.getElementById('pproc-title').textContent = 'Comprando con USDC…';
    document.getElementById('ptx-steps').innerHTML = '';
    try {
      var provider = new _ethers.BrowserProvider(_modal.getWalletProvider());
      var signer = await provider.getSigner();
      var usdc = new _ethers.Contract(USDC_ADDRESS, ERC20_ABI, signer);
      var nft  = new _ethers.Contract(CONTRACT_V2, ASH_ABI, signer);

      var balance = await usdc.balanceOf(connectedWallet);
      if (balance < PRICE_USDC) throw new Error('Saldo USDC insuficiente. Necesitas 60 USDC en Polygon.');

      var allowance = await usdc.allowance(connectedWallet, CONTRACT_V2);
      if (allowance < PRICE_USDC) {
        document.getElementById('pproc-sub').textContent = 'Aprueba el gasto de 60 USDC en tu wallet…';
        txStep('Aprobando 60 USDC…', false);
        var atx = await usdc.approve(CONTRACT_V2, PRICE_USDC);
        await atx.wait();
        document.getElementById('ptx-steps').lastChild.className = 'ptx-step done';
        document.getElementById('ptx-steps').lastChild.textContent = '✓ USDC aprobado';
      }
      document.getElementById('pproc-sub').textContent = 'Confirma la compra en tu wallet…';
      txStep('Acuñando NFT…', false);
      var mtx = await nft.mintWithUSDC(COLLECTION_ID, 1);
      await mtx.wait();
      document.getElementById('ptx-steps').lastChild.className = 'ptx-step done';
      document.getElementById('ptx-steps').lastChild.textContent = '✓ NFT acuñado';
      await sendWebhook(mtx.hash, 'USDC');
      showSuccess(mtx.hash);
    } catch(err) {
      document.getElementById('ppay-error').textContent = err?.reason || err?.message || 'Error en la transacción';
      document.getElementById('ppay-error').classList.remove('phidden');
      showPanel('pp-payment');
    }
  });

  // ── Pago POL ─────────────────────────────────────────────────────────────
  document.getElementById('pbtn-pol').addEventListener('click', async function() {
    if (!connectedWallet || !_ethers || !_modal) return;
    showPanel('pp-processing');
    document.getElementById('pproc-title').textContent = 'Comprando con POL…';
    document.getElementById('ptx-steps').innerHTML = '';
    try {
      var provider = new _ethers.BrowserProvider(_modal.getWalletProvider());
      var signer = await provider.getSigner();
      var nft = new _ethers.Contract(CONTRACT_V2, ASH_ABI, signer);
      var polReq = await nft.getPolAmount(PRICE_USDC);
      var polVal = polReq * 102n / 100n;
      var balance = await provider.getBalance(connectedWallet);
      if (balance < polVal) throw new Error('Saldo POL insuficiente. Necesitas ≈' + (Number(polReq)/1e18).toFixed(2) + ' POL.');
      document.getElementById('pproc-sub').textContent = 'Confirma la transacción en tu wallet…';
      txStep('Acuñando NFT con POL…', false);
      var mtx = await nft.mintWithPOL(COLLECTION_ID, 1, { value: polVal });
      await mtx.wait();
      document.getElementById('ptx-steps').lastChild.className = 'ptx-step done';
      document.getElementById('ptx-steps').lastChild.textContent = '✓ NFT acuñado';
      await sendWebhook(mtx.hash, 'POL');
      showSuccess(mtx.hash);
    } catch(err) {
      document.getElementById('ppay-error').textContent = err?.reason || err?.message || 'Error';
      document.getElementById('ppay-error').classList.remove('phidden');
      showPanel('pp-payment');
    }
  });

  // CLP is now handled in KYC submit

  // ── Helpers ───────────────────────────────────────────────────────────────
  async function sendWebhook(txHash, method) {
    try {
      await fetch(WEBHOOK, { method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({...kycData, metodoPago:method, txHash, estado:'Completado'}) });
    } catch(_) {}
  }
  function showSuccess(txHash) {
    showPanel('pp-success');
    if (txHash) {
      var box = document.getElementById('ptx-hash');
      box.innerHTML = '<p class="ptx-lbl">Transacción en Polygon</p><a href="https://polygonscan.com/tx/'+txHash+'" target="_blank" class="ptx-lnk">'+txHash.slice(0,18)+'…'+txHash.slice(-6)+' ↗</a>';
      box.classList.remove('phidden');
    }
  }
})();
</script>

<style>
  /* MODAL OVERLAY */
  .pmodal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.75); z-index:9999; display:flex; align-items:center; justify-content:center; padding:20px; backdrop-filter:blur(4px); }
  /* WalletConnect / AppKit modal must appear above our modal */
  w3m-modal, wcm-modal, appkit-modal, [data-testid="w3m-modal"] { z-index:100000 !important; position:relative; }
  .pmodal-box.wallet-open { visibility:hidden; }
  .pmodal-box { background:#111428; border:1px solid rgba(255,255,255,0.08); border-radius:20px; padding:40px; width:100%; max-width:520px; max-height:90vh; overflow-y:auto; position:relative; }
  .pmodal-close { position:absolute; top:16px; right:16px; background:rgba(255,255,255,0.08); border:none; color:rgba(255,255,255,0.5); width:32px; height:32px; border-radius:50%; cursor:pointer; font-size:14px; display:flex; align-items:center; justify-content:center; transition:all 0.2s; }
  .pmodal-close:hover { background:rgba(255,107,107,0.2); color:#ff6b6b; }

  /* STEPS */
  .psteps { display:flex; align-items:center; margin-bottom:32px; }
  .pstep { display:flex; flex-direction:column; align-items:center; gap:4px; }
  .pstep span:first-child { width:32px; height:32px; border-radius:50%; border:2px solid rgba(255,255,255,0.12); display:flex; align-items:center; justify-content:center; font-family:'Maven Pro',sans-serif; font-weight:700; font-size:13px; color:rgba(255,255,255,0.3); transition:all 0.3s; }
  .pstep-lbl { font-size:10px; color:rgba(255,255,255,0.25); font-family:'Archivo',sans-serif; font-weight:600; letter-spacing:0.04em; text-transform:uppercase; }
  .pstep.active span:first-child { border-color:#f7ad1f; color:#f7ad1f; background:rgba(247,173,31,0.1); }
  .pstep.active .pstep-lbl { color:#f7ad1f; }
  .pstep.done span:first-child { border-color:#4ade80; background:rgba(74,222,128,0.1); color:#4ade80; }
  .pstep.done .pstep-lbl { color:#4ade80; }
  .pstep-line { flex:1; height:2px; background:rgba(255,255,255,0.07); margin:0 8px 20px; }

  /* PANELS */
  .ppanel { display:none; }
  .ppanel.active { display:block; }
  .ppanel-icon { font-size:36px; margin-bottom:12px; line-height:1; }
  .pspin { display:inline-block; animation:pspin 1.2s linear infinite; }
  @keyframes pspin { to { transform:rotate(360deg); } }
  .ppanel-title { font-family:'Maven Pro',sans-serif; font-size:22px; font-weight:800; color:#fff; margin-bottom:8px; }
  .ppanel-sub { font-family:'Archivo',sans-serif; font-size:14px; color:rgba(255,255,255,0.5); line-height:1.7; margin-bottom:24px; }
  .pnote { font-size:11px; color:rgba(255,255,255,0.25); margin-top:14px; font-family:'Archivo',sans-serif; line-height:1.6; }

  /* BUTTONS */
  .pbtn-primary { display:inline-flex; align-items:center; justify-content:center; gap:8px; background:#f7ad1f; color:#0b0d1b; font-family:'Maven Pro',sans-serif; font-weight:800; font-size:12px; text-transform:uppercase; letter-spacing:0.05em; padding:11px 20px; border-radius:10px; border:none; cursor:pointer; text-decoration:none; transition:background 0.2s; }
  .pbtn-primary:hover { background:#ffc44d; }
  .pbtn-primary:disabled { background:rgba(247,173,31,0.3); cursor:not-allowed; }
  .pbtn-large { min-height:48px; font-size:13px; }
  .pbtn-ghost { display:inline-flex; align-items:center; justify-content:center; background:transparent; border:1px solid rgba(255,255,255,0.15); color:rgba(255,255,255,0.5); font-family:'Maven Pro',sans-serif; font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:0.04em; padding:10px 18px; border-radius:8px; cursor:pointer; transition:all 0.2s; }
  .pbtn-ghost:hover { border-color:rgba(255,255,255,0.3); color:rgba(255,255,255,0.8); }
  .pbtn-sm { background:transparent; border:1px solid rgba(255,255,255,0.2); color:rgba(255,255,255,0.5); border-radius:6px; padding:4px 10px; font-size:11px; cursor:pointer; transition:all 0.2s; }
  .pbtn-sm:hover { border-color:#f7ad1f; color:#f7ad1f; }

  /* WALLET CHIP */
  .pwallet-chip { display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:999px; padding:3px 12px; font-family:'Archivo',monospace; font-size:12px; color:rgba(255,255,255,0.5); }
  .pwallet-chip::before { content:''; width:7px; height:7px; background:#4ade80; border-radius:50%; }
  .pform-header { display:flex; align-items:center; gap:10px; margin-bottom:16px; flex-wrap:wrap; }

  /* FORM */
  .pform-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .pform-group { display:flex; flex-direction:column; gap:5px; margin-bottom:14px; }
  .pform-group label { font-family:'Archivo',sans-serif; font-size:12px; font-weight:600; color:rgba(255,255,255,0.65); }
  .preq { color:#f7ad1f; }
  .pform-group input, .pform-group select { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:10px 12px; color:#fff; font-family:'Archivo',sans-serif; font-size:13px; outline:none; transition:border-color 0.2s; width:100%; }
  .pform-group input::placeholder { color:rgba(255,255,255,0.2); }
  .pform-group input:focus, .pform-group select:focus { border-color:rgba(247,173,31,0.5); }
  .pform-group select option { background:#1a1f38; color:#fff; }
  .phidden { display:none !important; }
  .pform-check { display:flex; align-items:flex-start; gap:8px; margin-bottom:16px; }
  .pform-check input { width:16px; height:16px; min-width:16px; accent-color:#f7ad1f; margin-top:2px; cursor:pointer; }
  .pform-check label { font-family:'Archivo',sans-serif; font-size:12px; color:rgba(255,255,255,0.45); line-height:1.5; cursor:pointer; }
  .pform-check label a { color:#f7ad1f; text-decoration:none; }
  .perror { background:rgba(255,107,107,0.1); border:1px solid rgba(255,107,107,0.3); color:#ff6b6b; border-radius:8px; padding:10px 14px; font-family:'Archivo',sans-serif; font-size:12px; margin-top:10px; }

  /* METHOD CARDS (choose panel) */
  .pmethod-list { display:flex; flex-direction:column; gap:10px; }
  .pmethod-card { display:flex; align-items:center; gap:14px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.09); border-radius:14px; padding:14px 16px; cursor:pointer; text-align:left; transition:all 0.18s; width:100%; }
  .pmethod-card:hover { border-color:rgba(247,173,31,0.4); background:rgba(247,173,31,0.04); transform:translateX(2px); }
  .pmethod-icon-wrap { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden; }
  .pmethod-icon-wrap.usdc { background:none; border:none; }
  .pmethod-icon-wrap.pol  { background:none; border:none; }
  .pmethod-icon-wrap.clp  { background:none; border:none; }
  .pmethod-icon-wrap img  { width:44px; height:44px; object-fit:cover; display:block; }
