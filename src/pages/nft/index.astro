<script define:vars={{ OPEN_SEA_KEY: openSeaKey }}>
  (function () {
    // btn-buy-from-collections opener
    var btnFromColl = document.getElementById('btn-buy-from-coll');
    if (btnFromColl) {
      btnFromColl.addEventListener('click', function() {
        var m = document.getElementById('purchase-modal');
        if (m) { m.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
      });
    }

    // ── FAQ ──────────────────────────────────────────────────────────────────
    var CONTRACT_V2_FAQ = '0x40D9a1FDec62795723f065b05f792A6159727864';

    const FAQS = [
      ['¿Qué es un NFT productivo de Andes Solar Hash?', 'Es un token en blockchain Polygon que representa una fracción del resultado operativo del equipo. Al poseerlo, recibes una proporción de los BTC generados por esos equipos, después de cubrir sus costos.'],
      ['¿Cuánto puedo esperar ganar con mi NFT?', 'Los rendimientos varían según el precio del Bitcoin, la dificultad de la red y la eficiencia del equipo. Las estimaciones son orientativas y sujetas al mercado.'],
      ['¿Cómo se realizan los pagos de recompensas?', 'Los pagos se coordinan según el modelo del proyecto en POL (Polygon) o BTC a la wallet que posea el NFT.'],
      ['¿Puedo vender mi NFT en el mercado secundario?', 'Sí, los NFTs son transferibles en cualquier marketplace compatible con Polygon (ERC-1155), como Rarible o intercambio directo entre wallets.'],
      ['¿Qué infraestructura respalda estos NFTs?', 'Equipos Bitmain adquiridos por Andes SolarHash directo en Emiratos Árabes Unidos, conectados en alguna de las principales granjas de minería del mundo.'],
      ['¿Cuántos NFTs existen?', 'Existen 100 NFTs por cada equipo de minería tokenizado.'],
      ['¿Cómo verifico la propiedad?', 'Puedes verificar en PolygonScan el contrato ' + CONTRACT_V2_FAQ + '.'],
      ['¿Cuáles son los costos del equipo mes a mes?', 'Los costos operativos del equipo se dividen en: energía eléctrica 0.050 USD/kWh, servicio de hosting 0.026 USD/kWh y administración 0.004 USD/kWh. Estos se deducen de los ingresos brutos de minería antes de distribuir el margen operativo a los titulares de NFTs.'],
      ['¿Qué pasa si los costos fueron mayores a los ingresos?', 'Se genera una línea de crédito para el equipo, que será descontada de los flujos futuros cuando los ingresos superen los costos. En ningún caso el titular del NFT deberá realizar pagos adicionales.'],
      ['¿Qué son los Satoshis?', 'El Satoshi es la unidad más pequeña del Bitcoin. Un Bitcoin equivale a 100.000.000 Satoshis (1 BTC = 100,000,000 SAT). Es la unidad con la que se miden las recompensas de minería en cantidades pequeñas.'],
      ['¿Por qué son importantes los Satoshis en la minería de Bitcoin?', 'En la minería de Bitcoin, los ingresos diarios por equipo suelen expresarse en Satoshis porque representan fracciones muy pequeñas de un BTC completo. Entender los Satoshis permite evaluar con precisión la productividad de un equipo y comparar rendimientos entre distintos modelos de mineros.'],
      ['¿Cómo se calcula el flujo de recompensas?', 'El flujo neto de recompensas se calcula restando los costos operativos (energía, servicio y administración) de los ingresos brutos de minería. El resultado se distribuye en partes iguales entre los 100 NFTs del equipo tokenizado.'],
      ['¿Cuándo se transfieren los márgenes?', 'Semanalmente Andes SolarHash transfiere el margen operativo neto acumulado de la semana a cada wallet que posea un NFT activo del equipo correspondiente.'],
    ];

    function buildFAQ() {
      const el = document.getElementById('faqGrid');
      if (!el) return;
      el.innerHTML = FAQS.map(function (f, i) {
        return (
          '<div class="faq-item border-b border-white/[0.07]" data-i="' +
          i +
          '"><button type="button" class="faq-q w-full flex justify-between items-center gap-3 py-4 text-left cursor-pointer bg-transparent border-0"><span class="font-maven font-bold text-sm md:text-[14.5px] text-white leading-snug">' +
          f[0] +
          '</span><span class="faq-icon text-[#f7ad1f] text-base shrink-0 transition-transform duration-300">▲</span></button><div class="faq-answer max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out"><p class="text-sm text-white/50 leading-relaxed pb-0">' +
          f[1] +
          '</p></div></div>'
        );
      }).join('');
      el.querySelectorAll('.faq-item').forEach(function (row) {
        row.querySelector('.faq-q').addEventListener('click', function () {
          row.classList.toggle('open');
        });
      });
    }

    buildFAQ();
  })();
</script>

